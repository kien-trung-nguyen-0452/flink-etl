  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "tasks.max": 1,

    "database.hostname": "10.100.122.191",
    "database.port": "1433",
    "database.user": "sa",
    "database.password": "EaSYBoOK@Sds((2024",
    "database.names": "EB99_GR2",
    "database.encrypt": "false",

    "topic.prefix": "dwh-rl-eb99_gr2",

    "table.include.list": "dbo.RepositoryLedger",

    "snapshot.mode": "initial",
